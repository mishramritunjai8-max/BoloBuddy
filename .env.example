# ====================================================================
# BoloBuddy AI Environment Configuration
# ====================================================================

# 1. OPENROUTER API KEY (Required for BoloBuddy Educational Intelligence)
# Powers all 5 free models with automatic fallback:
#   1. baidu/ernie-5.5-flash-preview:free (Primary)
#   2. inclusionai/ling-3.2-flash:free (Fallback 1)
#   3. nvidia/nemotron-3.5-lightning:free (Fallback 2)
#   4. nvidia/nemotron-3-ultra-550b-a55b:free (Fallback 3)
#   5. nvidia/nemotron-3.5-super-vl:free (Fallback 4)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# 2. SPEECH TRANSCRIPTION KEY (Preserved for voice transcription)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Port (Default: 3000)
PORT=3000
