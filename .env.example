# GEMINI_API_KEY: Required for Gemini AI API calls (speech transcription & educational assistant).
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional server-side model overrides
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
GEMINI_TUTOR_MODEL="gemini-4-hydrogen"
