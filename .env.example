# ====================================================================
# BoloBuddy AI Environment Configuration
# ====================================================================

# 1. PRIMARY: Google Gemini API (Keep as primary key)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Primary Gemini Models (Official Google AI Studio production models)
GEMINI_TRANSCRIBE_MODEL="gemini-2.5-flash"
GEMINI_TUTOR_MODEL="gemini-2.5-flash"

# 2. OPTIONAL FREE HIGH-SPEED KEY: Groq Cloud API
# 100% Free forever tier, no credit card required.
# Sub-second latency: ~0.3s Whisper transcription & ~0.4s Llama 3.3 70B generation.
# Get free key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=""

# Optional Groq Model Overrides
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# 3. AI PROVIDER PREFERENCE:
# 'gemini' = Use Gemini as primary (fallback to Groq if rate-limited)
# 'groq'   = Use Groq as primary for lightning-fast latency (fallback to Gemini)
# 'auto'   = Automatically pick best active provider
AI_PROVIDER="gemini"

# Server Port
PORT=3000
